        ],
        "url": "{{baseUrl}}/api/employees/{{employeeId}}",
        "description": "Use one consistent HTTPS baseUrl so Postman retains the CSRF cookie. Credentials are local variables only.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"empName\": \"Demo Employee\",\n  \"email\": \"{{employeeEmail}}\",\n  \"phoneNumber\": \"9876543210\",\n  \"designation\": \"Senior Software Engineer\",\n  \"deptId\": 1,\n  \"managerId\": {{managerId}},\n  \"gender\": \"Female\",\n  \"address\": \"Pune\"\n}",
